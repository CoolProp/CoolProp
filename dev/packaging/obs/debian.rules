#!/usr/bin/make -f
#
# Debian packaging rules for CoolProp, built on the openSUSE Build Service.
# See dev/packaging/README.md in the CoolProp source tree.

# optimize=-lto: CoolProp embeds its fluid database with incbin, which emits a
# top-level __asm__ carrying a .incbin directive.  Under LTO that asm is
# re-assembled at link time by lto-wrapper, running from /tmp without the -I
# path that lets the assembler find dev/all_fluids.cbor, and the link fails
# with "Error: file not found: all_fluids.cbor".  Debian does not enable LTO
# by default, so this is a guard rather than a fix for a failure seen here;
# the RPM spec has to do the same thing because openSUSE and Fedora do.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	# dh's cmake buildsystem already passes CMAKE_INSTALL_PREFIX=/usr and the
	# multiarch CMAKE_INSTALL_LIBDIR, which the install rules then use.
	# COOLPROP_REQUIRE_VENDORED_DEPS makes the configure step fail loudly if
	# anything would have to be downloaded, which it cannot do in the build
	# chroot anyway.
	dh_auto_configure -- \
		-DCOOLPROP_SHARED_LIBRARY=ON \
		-DCOOLPROP_INSTALL_CMAKE_PACKAGE=ON \
		-DCOOLPROP_INSTALL_LEGACY_LAYOUT=OFF \
		-DCOOLPROP_INSTALL_FLAT_HEADERS=OFF \
		-DCOOLPROP_VENDOR_THIRD_PARTY=OFF \
		-DCOOLPROP_REQUIRE_VENDORED_DEPS=ON \
		-DCOOLPROP_NO_EXAMPLES=ON

override_dh_auto_test:
	# The Catch2 suite is not built here: BUILD_TESTING is off, and the test
	# data would make the source package considerably larger.  CoolProp's own
	# CI runs the suite on every commit.
