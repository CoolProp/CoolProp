
# Set default behaviour, in case users don't have core.autocrlf set.
* text=auto

# Explicitly declare text files we want to always be normalized and converted 
# to native line endings on checkout.
*.c text
*.h text
*.mo text
*.order text
*.py text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.bat text eol=crlf
*.csproj text eol=crlf
*.cs text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.pdf binary

# The EES library file is a text body wrapped in a header that records its
# length, so a line ending conversion would leave that header wrong.
wrappers/EES/CoolProp.LIB binary

# Shipped verbatim in every wheel/sdist and byte-compared by
# dev/ci/check_dist_notices.py; keep LF on every platform (incl. Windows builds).
THIRD_PARTY_NOTICES.md text eol=lf
