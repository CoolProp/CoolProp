; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
;
; This is the stand-alone installer for the EES wrapper only.  The installer
; that is actually shipped is built from the CoolProp/ExcelAddinInstaller
; repository, this script is kept for a quick local package of the two
; libraries.  Run it from the directory that holds the "source" tree created
; by the COOLPROP_WINDOWS_PACKAGE_EES and COOLPROP_WINDOWS_PACKAGE_EES64
; targets, see wrappers/EES/EES64.md.

#define MyAppName "CoolProp"
#define MyAppVersion "${COOLPROP_VERSION}"
#define MyAppPublisher "University of Liege"
#define MyAppURL "www.coolprop.org"

; The 32-bit program loads .dlf and .LIB files from Userlib, the 64-bit
; program (EES64.exe) loads .dlf64 and .LIB64 files from Userlib64.  Neither
; can use the library of the other bitness, so both are installed.
#define EesDir32 "c:\EES32\Userlib\COOLPROP_EES"
#define EesDir64 "c:\EES64\Userlib64\COOLPROP_EES"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{AECD4969-A5A5-4AF4-97AD-544A3890BF1C}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={#EesDir32}
DisableDirPage=yes
DefaultGroupName=CoolProp_EES
OutputBaseFilename=SetupCOOLPROP_EES
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; 32-bit EES
Source: "source\EES\CoolProp.htm"; DestDir: "{#EesDir32}"; Flags: ignoreversion; Tasks: EesUserLib
Source: "source\EES\CoolProp.LIB"; DestDir: "{#EesDir32}"; Flags: ignoreversion; Tasks: EesUserLib
Source: "source\EES\COOLPROP_EES.dlf"; DestDir: "{#EesDir32}"; Flags: ignoreversion; Tasks: EesUserLib
Source: "source\EES\CoolProp_EES_Sample.EES"; DestDir: "{#EesDir32}"; Flags: ignoreversion; Tasks: EesUserLib
; 64-bit EES
Source: "source\EES\CoolProp.htm"; DestDir: "{#EesDir64}"; Flags: ignoreversion; Tasks: EesUserLib64
Source: "source\EES64\CoolProp.LIB64"; DestDir: "{#EesDir64}"; Flags: ignoreversion; Tasks: EesUserLib64
Source: "source\EES64\COOLPROP_EES.dlf64"; DestDir: "{#EesDir64}"; Flags: ignoreversion; Tasks: EesUserLib64
Source: "source\EES\CoolProp_EES_Sample.EES"; DestDir: "{#EesDir64}"; Flags: ignoreversion; Tasks: EesUserLib64
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Tasks]
Name: EesUserLib; Description: "Install the library for the 32-bit EES (EES.exe)"
Name: EesUserLib64; Description: "Install the library for the 64-bit EES (EES64.exe)"

[Icons]
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
